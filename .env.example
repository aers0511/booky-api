# Google Gemini
GEMINI_API_KEY=PEGA_AQUI_TU_CLAVE
GEMINI_MODEL=gemini-3.8-flash

# Dominios que pueden llamar al backend
ALLOWED_ORIGINS=https://sib.itson.edu.mx,https://biblioteca.itson.mx

# Koha (cuenta técnica con permiso catalogue: 1 y sin permisos de edición)
KOHA_ENABLED=false
# Si es true, Booky pregunta el campus cuando una búsqueda no lo especifica.
KOHA_ASK_CAMPUS=true
KOHA_BASE_URL=https://sib.itson.edu.mx
KOHA_API_PATH=/api/v1
KOHA_API_USERNAME=
KOHA_API_PASSWORD=
KOHA_TIMEOUT_MS=7000
KOHA_MAX_RESULTS=5
KOHA_MAX_ITEMS=40

# Tiempo total aproximado de procesamiento
REQUEST_TIMEOUT_MS=27000

# Endpoint independiente para solicitudes de adquisición (Google Apps Script)
# Genera una clave larga y guárdala también en las propiedades del script de Apps Script.
ACQUISITIONS_API_KEY=GENERA_UNA_CLAVE_SECRETA_LARGA
ACQUISITIONS_MAX_BOOKS=15
ACQUISITIONS_MAX_RESULTS=10

# Búsqueda de usuarios para adquisiciones (cuenta Koha independiente)
# Esta cuenta requiere permiso de consulta de usuarios/patrons en la API REST.
KOHA_PATRONS_ENABLED=false
KOHA_PATRONS_API_USERNAME=
KOHA_PATRONS_API_PASSWORD=
